{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "migrate:strip-blobs": "tsx scripts/strip-legacy-blobs.ts --dry-run",
    "migrate:strip-blobs:apply": "tsx scripts/strip-legacy-blobs.ts --apply"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
