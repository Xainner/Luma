# --- Base de datos ---
# SQLite (por defecto) — no requiere servidor externo
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/luma.db

# --- PostgreSQL (opcional, solo si DATABASE_TYPE=postgres) ---
# POSTGRES_USER=luma
# POSTGRES_DB=luma
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://luma:change-me@localhost:17016/luma
